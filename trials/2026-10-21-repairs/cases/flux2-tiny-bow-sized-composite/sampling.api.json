{
  "base": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "flux2-klein-bench/flux2-klein-single-color-pinned.png"
    }
  },
  "rendered": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "repair_inputs/flux2-bow-large.png"
    }
  },
  "crop": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "rendered",
        0
      ],
      "x": 106,
      "y": 330,
      "width": 56,
      "height": 49
    }
  },
  "scale": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "crop",
        0
      ],
      "upscale_method": "lanczos",
      "width": 22,
      "height": 20,
      "crop": "disabled"
    }
  },
  "red": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "scale",
        0
      ],
      "channel": "red"
    }
  },
  "threshold": {
    "class_type": "ThresholdMask",
    "inputs": {
      "mask": [
        "red",
        0
      ],
      "value": 0.3
    }
  },
  "grow": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "threshold",
        0
      ],
      "expand": 1,
      "tapered_corners": true
    }
  },
  "composite": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "base",
        0
      ],
      "source": [
        "scale",
        0
      ],
      "mask": [
        "grow",
        0
      ],
      "x": 122,
      "y": 328,
      "resize_source": false
    }
  },
  "black": {
    "class_type": "SolidMask",
    "inputs": {
      "value": 0,
      "width": 368,
      "height": 672
    }
  },
  "fullmask": {
    "class_type": "MaskComposite",
    "inputs": {
      "destination": [
        "black",
        0
      ],
      "source": [
        "grow",
        0
      ],
      "x": 122,
      "y": 328,
      "operation": "add"
    }
  },
  "maskimage": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "fullmask",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "composite",
        0
      ],
      "filename_prefix": "RepairBench/flux2-tiny-bow-sized-composite"
    }
  },
  "saveinput": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "base",
        0
      ],
      "filename_prefix": "RepairBench/flux2-tiny-bow-sized-composite-input"
    }
  },
  "savemask": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "maskimage",
        0
      ],
      "filename_prefix": "RepairBench/flux2-tiny-bow-sized-composite-mask"
    }
  }
}